; U9ChtProxy.dll is installed as <game>\dsound.dll. The names and ordinals are those of the system dsound.dll;
; u9.exe imports ordinals 1 and 2.
LIBRARY U9ChtProxy
EXPORTS
    DirectSoundCreate=proxy_DirectSoundCreate @1
    DirectSoundEnumerateA=proxy_DirectSoundEnumerateA @2
    DirectSoundEnumerateW=proxy_DirectSoundEnumerateW @3
    DllCanUnloadNow=proxy_DllCanUnloadNow @4 PRIVATE
    DllGetClassObject=proxy_DllGetClassObject @5 PRIVATE
    DirectSoundCaptureCreate=proxy_DirectSoundCaptureCreate @6
    DirectSoundCaptureEnumerateA=proxy_DirectSoundCaptureEnumerateA @7
    DirectSoundCaptureEnumerateW=proxy_DirectSoundCaptureEnumerateW @8
    GetDeviceID=proxy_GetDeviceID @9
    DirectSoundFullDuplexCreate=proxy_DirectSoundFullDuplexCreate @10
    DirectSoundCreate8=proxy_DirectSoundCreate8 @11
    DirectSoundCaptureCreate8=proxy_DirectSoundCaptureCreate8 @12
